DATABASE_URL=sqlite:////app/data/scrappervol.db
DATA_DIR=/app/data
TIMEZONE=America/Toronto

# Remplacez ces quatre valeurs, sinon aucune alerte ne partira : les domaines en `example.com`
# sont réservés à la documentation et ne résolvent nulle part. Tant qu'ils sont là, la veille
# collecte et détecte normalement, mais n'envoie rien — la page /santé le dit et propose un
# envoi de test pour éprouver la chaîne sans attendre une aubaine.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=scrappervol@example.com
ALERT_TO=moi@example.com

INTERVAL_GOOGLE_HOURS=4
INTERVAL_TRANSAT_HOURS=6
INTERVAL_AIR_CANADA_HOURS=8
INTERVAL_KAYAK_HOURS=4
DIGEST_HOUR=18

EXCEPTION_THRESHOLD=0.40
FIND_THRESHOLD=0.15
CREDIBILITY_FLOOR_CAD=50
MIN_HISTORY_DAYS=14
HISTORY_WINDOW_DAYS=90
RETENTION_DAYS=90
MAX_QUERIES_PER_ROUTE=6
REQUEST_PAUSE_MIN_S=5
REQUEST_PAUSE_MAX_S=20

# Quatre sources exploitables en l'état.
#
# `transat` pilote le formulaire jusqu'à la page récapitulative `/summary` et y lit le total
# aller-retour affiché (`.flight-container-total .price`), au tarif le moins cher disponible — pas
# le prix d'ALLER SIMPLE de l'étape « departure » qui l'avait fait retirer de cette liste.
#
# `air_canada` a été rouverte le 6 août. Le premier essai concluait à une protection
# anti-automatisation infranchissable (BKRW-DBS-999) ; la cause était que le navigateur tournait
# sans fenêtre. Le même parcours mené à fenêtre aboutit au récapitulatif et à son total.
# Voir docs/superpowers/notes/2026-08-06-air-canada-reouverture.md.
#
# `kayak` n'est pas un transporteur mais un comparateur : un relevé y rapporte les tarifs de
# vingt-quatre revendeurs (Expedia, FlightHub, Gotogate, Trip.com, eDreams, Kiwi.com), dont les
# sites refusent les robots un par un. C'est de ce côté que passent les tarifs les plus agressifs.
ENABLED_PROVIDERS=google_flights,transat,air_canada,kayak
