DATABASE_URL=sqlite:////app/data/scrappervol.db
DATA_DIR=/app/data
TIMEZONE=America/Toronto

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=scrappervol@example.com
ALERT_TO=moi@example.com

INTERVAL_GOOGLE_HOURS=4
# Sans effet tant que les sources correspondantes restent hors d'ENABLED_PROVIDERS.
INTERVAL_TRANSAT_HOURS=6
INTERVAL_AIR_CANADA_HOURS=8
DIGEST_HOUR=18

EXCEPTION_THRESHOLD=0.40
FIND_THRESHOLD=0.15
CREDIBILITY_FLOOR_CAD=50
MIN_HISTORY_DAYS=14
HISTORY_WINDOW_DAYS=90
RETENTION_DAYS=90
MAX_QUERIES_PER_ROUTE=6
REQUEST_PAUSE_MIN_S=5
REQUEST_PAUSE_MAX_S=20

# Une seule source est exploitable en l'état.
#
# `transat` fonctionne techniquement mais ne publie qu'un prix d'ALLER SIMPLE. Comme le plus bas
# du jour est conservé sans distinguer la source, ce prix — environ moitié moindre qu'un
# aller-retour — deviendrait le plus bas permanent du trajet et effondrerait la médiane de
# référence : plus aucune aubaine ne serait jamais détectée, et tout resterait vert. Ne la
# rallumer qu'après avoir obtenu un prix d'aller-retour complet.
#
# `air_canada` est abandonnée : le site rejette toute soumission automatisée (BKRW-DBS-999, puis
# 403 Akamai sur l'URL directe). Voir docs/superpowers/notes/2026-08-05-air-canada-abandon.md.
ENABLED_PROVIDERS=google_flights
