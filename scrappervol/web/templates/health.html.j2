{% extends "base.html.j2" %}
{% import "ui.html.j2" as ui %}
{% block titre %}Santé — ScrapperVol{% endblock %}
{% block contenu %}

<h1>Santé</h1>

<section data-canal="email">
  <h2>Remise des alertes</h2>
  {% if not courriel.utilisable %}
    <p class="erreur" data-etat="non-configure">
      {{ ui.badge("aucune alerte ne partira", ton="rouge") }}
      {{ courriel.defaut_configuration }}. Tant que ce réglage manque, les aubaines sont détectées
      et enregistrées, mais rien n'est envoyé. Corrigez le fichier <code>.env</code>, puis
      relancez le conteneur.
    </p>
  {% elif courriel.en_panne %}
    <p class="erreur" data-etat="en-panne">
      {{ ui.badge("envoi en échec", ton="rouge") }}
      {{ courriel.consecutive_failures }} échec(s) consécutif(s) vers
      <strong>{{ courriel.destinataire }}</strong>.
      <span class="discret">{{ courriel.last_error }}</span>
    </p>
  {% else %}
    <p data-etat="ok">
      {{ ui.badge("prêt", ton="vert") }}
      Destinataire : <strong>{{ courriel.destinataire }}</strong>.
      {% if courriel.last_success_at %}
        Dernier envoi réussi le {{ courriel.last_success_at.strftime('%Y-%m-%d %H:%M') }} UTC.
      {% else %}
        <span class="faible">Aucun envoi à ce jour.</span>
      {% endif %}
    </p>
  {% endif %}

  {% if test_erreur %}
    <p class="erreur" data-test-resultat="echec">{{ test_erreur }}</p>
  {% elif test_reussi %}
    <p data-test-resultat="succes">
      {{ ui.badge("envoyé", ton="vert") }} Courriel de test remis à
      <strong>{{ courriel.destinataire }}</strong>.
    </p>
  {% endif %}

  <form method="post" action="/health/test-courriel" class="actions">
    {{ ui.bouton("Envoyer un courriel de test", ton="discret") }}
    <span class="discret">Vérifie la chaîne complète sans attendre une aubaine.</span>
  </form>
</section>

<h2>Sources</h2>
<p class="sous-titre">Une source qui n'a rien produit depuis plus de 48 h est signalée : c'est la
panne silencieuse qu'il faut voir venir.</p>

<table>
  <thead>
    <tr>
      <th>Source</th>
      <th>Dernier succès</th>
      <th>Échecs consécutifs</th>
      <th>Offres au dernier passage</th>
      <th>Dernière erreur</th>
    </tr>
  </thead>
  <tbody>
    {% for s in sources %}
      <tr data-source="{{ s.provider }}"{% if s.is_stale %} data-muet{% endif %}>
        <td>
          <strong>{{ s.provider }}</strong>
          {% if s.is_stale %}
            {{ ui.badge("muette", ton="rouge") }}
          {% endif %}
        </td>
        <td data-dernier-succes>
          {% if s.last_success_at %}
            {{ s.last_success_at.strftime('%Y-%m-%d %H:%M') }} UTC
          {% else %}
            <span class="faible">jamais</span>
          {% endif %}
        </td>
        <td data-echecs="{{ s.consecutive_failures }}">{{ s.consecutive_failures }}</td>
        <td data-offres="{{ s.offers_last_run }}">{{ s.offers_last_run }}</td>
        <td class="discret">{{ s.last_error or '—' }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

{% endblock %}
