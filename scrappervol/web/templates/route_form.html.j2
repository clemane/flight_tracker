{% extends "base.html.j2" %}
{% import "ui.html.j2" as ui %}
{% block titre %}{% if route %}Modifier un trajet{% else %}Nouveau trajet{% endif %} — ScrapperVol{% endblock %}
{% block contenu %}

<h1>{% if route %}Modifier un trajet{% else %}Nouveau trajet{% endif %}</h1>
<p class="sous-titre">Un trajet surveillé est relevé automatiquement et entre dans le digest
quotidien.</p>

{% if erreur %}<p class="erreur" data-erreur>{{ erreur }}</p>{% endif %}

<form class="formulaire carte carte-corps" method="post"
      action="{% if route %}/routes/{{ route.id }}{% else %}/routes{% endif %}">

  {% call ui.rangee() %}
    {{ ui.champ("label", "Libellé", valeur=route.label if route else "",
                placeholder="Paris au printemps", requis=true) }}
  {% endcall %}

  {% call ui.rangee() %}
    {{ ui.champ_aeroport("origins", "Origines", multiple=true, requis=true,
                         placeholder="Montréal, Québec…",
                         valeur=route.origins | join(', ') if route else 'YUL, YQB') }}
    {{ ui.champ_aeroport("destinations", "Destinations", multiple=true, requis=true,
                         placeholder="Paris, Lisbonne…",
                         valeur=route.destinations | join(', ') if route else '') }}
  {% endcall %}

  {% call ui.rangee() %}
    {{ ui.champ_select("date_policy", "Politique de dates",
                       [('fixed', 'Dates fixes'), ('window', 'Fenêtre de mois'),
                        ('flexible', 'Totalement souple')],
                       valeur=date_policy,
                       extra='hx-get="/routes/policy-fields" hx-target="#champs-politique"
                              hx-trigger="change" hx-include="closest form" hx-swap="innerHTML"') }}
  {% endcall %}

  <div id="champs-politique">
    {% include "policy_fields.html.j2" %}
  </div>

  {% call ui.rangee() %}
    {{ ui.champ_select("trip_type", "Type",
                       [('round_trip', 'Aller-retour'), ('one_way', 'Aller simple')],
                       valeur=route.trip_type if route else 'round_trip') }}
    {{ ui.champ("passengers", "Passagers", type="number", min=1,
                valeur=route.passengers if route else 1) }}
    {{ ui.champ("max_stops", "Escales maximales", type="number", min=0, placeholder="sans limite",
                valeur=route.max_stops if route and route.max_stops is not none else '') }}
  {% endcall %}

  {% call ui.rangee() %}
    {{ ui.champ("target_price_cad", "Prix cible (CAD)", type="number", min=1, placeholder="aucun",
                valeur=route.target_price_cad if route and route.target_price_cad else '') }}
    {{ ui.champ("exception_threshold", "Seuil d'aberration", type="number",
                min=0.05, max=0.95, pas=0.05,
                valeur=route.exception_threshold if route else 0.40) }}
  {% endcall %}

  <div class="actions">
    {{ ui.bouton("Enregistrer" if route else "Créer le trajet") }}
    {{ ui.bouton("Annuler", href="/routes", ton="discret") }}
  </div>
</form>

{% endblock %}
