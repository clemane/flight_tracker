{# Une carte de trajet. S'appuie sur la variable de boucle `route` du gabarit appelant. #}
<article class="trajet{% if not route.active %} trajet-inactif{% endif %}" data-trajet="{{ route.id }}">
  <div>
    <div class="trajet-libelle">{{ route.label }}</div>
    <div class="discret">
      {{ route.origins | join(', ') }} → {{ route.destinations | join(', ') }}
      <span class="point">·</span> {{ route.date_policy }}
      {% if route.target_price_cad %}
        <span class="point">·</span> cible {{ route.target_price_cad }} $
      {% endif %}
    </div>
  </div>

  <div>
    {% if route.active %}
      <span class="badge badge-vert" data-actif>actif</span>
    {% else %}
      <span class="badge" data-inactif>désactivé</span>
    {% endif %}
  </div>

  <div class="actions">
    <a class="bouton bouton-discret bouton-petit" href="/routes/{{ route.id }}/edit">Modifier</a>
    <form class="en-ligne" method="post" action="/routes/{{ route.id }}/toggle">
      <button class="bouton bouton-discret bouton-petit" type="submit">
        {% if route.active %}Mettre en pause{% else %}Réactiver{% endif %}
      </button>
    </form>
    <form class="en-ligne" method="post" action="/routes/{{ route.id }}/delete"
          onsubmit="return confirm('Supprimer ce trajet et son historique ?')">
      <button class="bouton bouton-discret bouton-danger bouton-petit" type="submit">Supprimer</button>
    </form>
  </div>
</article>
