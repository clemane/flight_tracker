{% import "ui.html.j2" as ui %}

{% if date_policy == 'fixed' %}
  {% call ui.rangee() %}
    {{ ui.champ_plage_dates("depart", "Départ", nom_fin="retour", etiquette_fin="Retour",
                            valeur_debut=params.get('depart', ''),
                            valeur_fin=params.get('retour', '')) }}
    {{ ui.champ("flex_days", "Souplesse (jours)", type="number", min=0, max=14,
                valeur=params.get('flex_days', 0)) }}
  {% endcall %}

{% elif date_policy == 'window' %}
  {% call ui.rangee() %}
    {{ ui.champ("mois", "Mois visés", aide="(AAAA-MM, séparés par des virgules)",
                placeholder="2027-03, 2027-04", valeur=params.get('mois', []) | join(', ')) }}
  {% endcall %}
  {% call ui.rangee() %}
    {{ ui.champ("sejour_min", "Séjour minimal (jours)", type="number", min=1,
                valeur=params.get('sejour_min', 8)) }}
    {{ ui.champ("sejour_max", "Séjour maximal (jours)", type="number", min=1,
                valeur=params.get('sejour_max', 12)) }}
  {% endcall %}

{% else %}
  {% call ui.rangee() %}
    {{ ui.champ("horizon_mois", "Horizon (mois)", type="number", min=1, max=12,
                valeur=params.get('horizon_mois', 12)) }}
    {{ ui.champ("sejour_min", "Séjour minimal (jours)", type="number", min=1,
                valeur=params.get('sejour_min', 7)) }}
    {{ ui.champ("sejour_max", "Séjour maximal (jours)", type="number", min=1,
                valeur=params.get('sejour_max', 14)) }}
  {% endcall %}
{% endif %}
