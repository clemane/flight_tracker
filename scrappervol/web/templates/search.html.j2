{% extends "base.html.j2" %}
{% import "ui.html.j2" as ui %}
{% block titre %}Recherche — ScrapperVol{% endblock %}
{% block contenu %}

<h1>Rechercher un vol</h1>
<p class="sous-titre">Les sources sont interrogées à l'instant, rien n'est enregistré.</p>

<form class="recherche" method="post" action="/search"
      hx-post="/search" hx-target="#resultats" hx-swap="outerHTML">
  <div class="recherche-grille">
    {{ ui.champ_aeroport("origin", "Départ", placeholder="Montréal", requis=true) }}
    {{ ui.champ_aeroport("destination", "Arrivée", placeholder="Cancún", requis=true) }}
    {{ ui.champ_plage_dates("depart", "Aller", nom_fin="retour", etiquette_fin="Retour",
                            min=aujourdhui) }}
    {{ ui.champ("passengers", "Voyageurs", type="number", valeur=1, min=1, max=9) }}
    <div class="champ champ-action">
      <button class="bouton" type="submit">
        <span class="chargement"><span class="tourniquet"></span></span>
        Rechercher
      </button>
    </div>
  </div>
</form>

<div id="resultats"></div>

<section class="section">
  {% call ui.entete_section("Trajets surveillés", compte=lignes | length) %}
    {{ ui.bouton("＋ Nouveau trajet", href="/routes/new", ton="second bouton-petit") }}
  {% endcall %}

  {% if not lignes %}
    {{ ui.vide("Rien n'est surveillé pour l'instant.",
               detail="Lancez une recherche ci-dessus, puis « Surveiller ce trajet » pour en suivre le prix jour après jour.",
               crochet="aucun-trajet") }}
  {% else %}
    <div class="grille">
      {% for ligne in lignes %}
        <article class="trajet{% if not ligne.route.active %} trajet-inactif{% endif %}"
                 data-trajet="{{ ligne.route.id }}"
                 {% if ligne.is_find %}data-trouvaille{% endif %}>
          <div>
            <div class="trajet-libelle">{{ ligne.route.label }}</div>
            <div class="discret">
              {{ ligne.route.origins | join(', ') }} → {{ ligne.route.destinations | join(', ') }}
              {% if not ligne.route.active %}
                {{ ui.badge("en pause") }}
              {% endif %}
            </div>
          </div>

          <div>
            {% if ligne.price_cad %}
              <div class="trajet-prix" data-prix="{{ ligne.price_cad }}">{{ ligne.price_cad }} $</div>
              <div class="discret" data-provider="{{ ligne.provider }}">{{ ligne.provider }}</div>
            {% else %}
              <div class="discret" data-sans-releve>aucun relevé aujourd'hui</div>
            {% endif %}
          </div>

          <div>
            {% if ligne.history_building %}
              {{ ui.badge("historique en constitution", ton="ambre", crochet="historique-en-cours") }}
            {% elif ligne.gap_vs_median is not none %}
              <div>
                {% if ligne.gap_vs_median > 0 %}
                  {{ ui.badge((ligne.gap_vs_median * 100) | round | int ~ " % sous la médiane",
                              ton="vert", crochet="ecart") }}
                {% else %}
                  {{ ui.badge((ligne.gap_vs_median * -100) | round | int ~ " % au-dessus",
                              crochet="ecart") }}
                {% endif %}
              </div>
              <div class="discret" data-mediane="{{ ligne.median_price | round | int }}">
                médiane {{ ligne.median_price | round | int }} $
              </div>
            {% endif %}
            {% if ligne.points %}
              <svg class="sparkline" width="140" height="34" viewBox="0 0 240 48"
                   preserveAspectRatio="none" role="img" aria-label="historique des prix">
                <polyline fill="none" stroke="currentColor" stroke-width="2"
                          stroke-linejoin="round" points="{{ ligne.points }}"></polyline>
              </svg>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% endblock %}
