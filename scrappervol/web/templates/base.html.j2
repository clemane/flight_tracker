<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block titre %}ScrapperVol{% endblock %}</title>
  <link rel="stylesheet" href="/static/app.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>&#9992;</text></svg>">
  <script src="/static/htmx.min.js" defer></script>
  <script src="/static/app.js" defer></script>
</head>
<body>
  <header class="entete">
    <div class="entete-interieur">
      <a class="marque" href="/">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/>
        </svg>
        ScrapperVol
      </a>
      <nav class="nav">
        <a href="/"{% if page == 'recherche' %} aria-current="page"{% endif %}>Recherche</a>
        <a href="/routes"{% if page == 'trajets' %} aria-current="page"{% endif %}>Trajets</a>
        <a href="/health"{% if page == 'sante' %} aria-current="page"{% endif %}>Santé</a>
      </nav>
    </div>
  </header>
  <main>
    {% block contenu %}{% endblock %}
  </main>
</body>
</html>
