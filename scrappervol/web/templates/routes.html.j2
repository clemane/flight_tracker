{% extends "base.html.j2" %}
{% block titre %}Trajets — ScrapperVol{% endblock %}
{% block contenu %}

<div class="section-entete">
  <h1>Trajets</h1>
  <span class="a-droite"><a class="bouton" href="/routes/new">＋ Nouveau trajet</a></span>
</div>

{% if not routes %}
  <div class="vide" data-aucun-trajet>
    <p>Aucun trajet pour l'instant.</p>
    <a class="bouton" href="/routes/new">Créer un trajet</a>
  </div>
{% else %}
  <div class="grille">
    {% for route in routes %}
      {% include "route_row.html.j2" %}
    {% endfor %}
  </div>
{% endif %}

{% endblock %}
